{
  "expo": {
    "name": "TravelSwipe",
    "slug": "TravelSwipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "travelswipe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.absarkar.travelswipe",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.434894631813-6vgtmutnms86l0sjj8pc196bbs7n4so0"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.absarkar.travelswipe"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location?"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
